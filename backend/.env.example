# Parakh backend configuration. Copy values into your shell environment or a
# git-ignored .env loader. Never commit real values.

# development | test | production
PARAKH_ENV=development

# Required in production; generated locally in development (backend/.local/dev-keys.json).
DJANGO_SECRET_KEY=
PARAKH_PHONE_HMAC_KEY=
PARAKH_PHONE_ENC_KEY=          # a Fernet key
PARAKH_OTP_HASH_KEY=
DJANGO_ALLOWED_HOSTS=

# Database. Omit for the local SQLite substitute (development/test only).
PARAKH_DB_ENGINE=              # postgresql
PARAKH_DB_NAME=
PARAKH_DB_USER=
PARAKH_DB_PASSWORD=
PARAKH_DB_HOST=localhost
PARAKH_DB_PORT=5432

# SMS. Development defaults to the SIMULATED console adapter; production must name a real sender.
PARAKH_SMS_BACKEND=

# OTP limits — PROPOSED DEFAULTS awaiting Hassan's decision (DG-13).
PARAKH_OTP_RESEND_COOLDOWN_SECONDS=60
PARAKH_OTP_MAX_PER_NUMBER_PER_HOUR=3
PARAKH_OTP_MAX_PER_NUMBER_PER_DAY=10
PARAKH_OTP_MAX_PER_DEVICE_PER_HOUR=5
PARAKH_OTP_MAX_PER_IP_PER_HOUR=20

# Session lifetimes — development defaults; no source value exists (DG-52).
PARAKH_ACCESS_TOKEN_TTL_SECONDS=900
PARAKH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Identifier of the consent text shown on CIT-02/CIT-03 (placeholder until T-045).
PARAKH_CONSENT_VERSION=citizen-consent-draft-1

# Reporting. Retry window — PROVISIONAL: a labelled default from a proposal in the incoming documents (DG-14).
PARAKH_DRAFT_RETRY_WINDOW_DAYS=7
# Upload cap — PROVISIONAL technical safeguard (photos plus the one recording), not a product rule.
PARAKH_EVIDENCE_MAX_ITEMS=12
# Product photo-count maximum — Hassan's decision (TBD-M9 / DG-47). Leave empty until decided.
PARAKH_PHOTO_COUNT_MAX=

# Evidence storage. Development defaults to the local write-once store under backend/.local/evidence;
# production must name a write-once object store (none exists yet).
PARAKH_EVIDENCE_STORAGE=
PARAKH_EVIDENCE_ROOT=

# AI rendering. Development defaults to the SIMULATED adapter (DG-16, DG-48); production must name a real one.
PARAKH_AI_BACKEND=
PARAKH_SIMULATED_AI_OUTCOME=complete   # complete | fail | review_required (development only)
PARAKH_LOW_CONFIDENCE_THRESHOLD=0.6    # no source value exists

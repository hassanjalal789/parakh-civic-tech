# Parakh mobile configuration. Never commit real values or secrets; nothing
# here is a secret. EXPO_PUBLIC_* values are bundled into the app.

# development (default) | release. A release build refuses a non-https API URL.
APP_VARIANT=development

# Local backend. 10.0.2.2 is the host machine as seen from the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
